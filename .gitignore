# 构建产物：一条命令可重建，不进版本库
output/

# 复现环境（隔离虚拟环境）
.venv/
.env-mafft/

# Python 缓存
__pycache__/
*.pyc

# 系统文件
.DS_Store

# 依赖（外部 clone 自带）
node_modules/

# 外部参考 clone（各自有上游仓库 GPTomics/bioSkills、obsidian-wechat-converter，不纳入本库备份；
# 本库只备份自身源 content/笔记|素材|pipeline，构建前按需从上游 git clone）
content/库/bioSkills/
content/库/obsidian-wechat-converter/
content/库/md2card/

# WorkBuddy 临时产物（预览/输出缓存，不进版本库）
.workbuddy/artifacts/

# 真跑工作区（015 起）：保留中间产物供本地复现，不入库；
# 可独立复现的最小集已落在 content/素材/<cat>/00X-*/（含 make_figs.py / repro_transcript.txt）。
# 注：004–006 早期工作区已入库，故只忽略 015 及之后。
pipeline/01[5-9]-*/
pipeline/02[0-9]-*/
